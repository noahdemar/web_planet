{
  "name": "world-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Planetary terrain generator — orbit to ground, fully procedural.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "hypsometry": "tsx tools/hypsometry.ts",
    "precision": "tsx tools/precision.ts",
    "verify": "tsc --noEmit && tsx tools/precision.ts && tsx tools/hypsometry.ts"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
